# Copy to .env (or .env.local) and fill in the values from your Supabase project.
# These are PUBLIC vars — they ship to the browser. That's expected: security comes
# from the RLS / Storage policies in the dashboard (anon allowed INSERT only).

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
PUBLIC_SUPABASE_BUCKET=samjuba-uploads
PUBLIC_UPLOADS_TABLE=uploads
